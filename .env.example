# =====================================================================
# Copie este archivo con el nombre .env y cambie las contraseñas.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).
# Use contraseñas de al menos 12 caracteres.
# =====================================================================

# Superusuario de PostgreSQL: solo para administrar la base, la aplicación no lo usa
POSTGRES_PASSWORD=cambie-esta-clave

# Conexión de la aplicación, con el usuario de mínimo privilegio
ALTAMAR_DB_URL=jdbc:postgresql://127.0.0.1:5433/altamar
ALTAMAR_DB_USER=altamar_app
ALTAMAR_DB_PASSWORD=cambie-esta-otra-clave